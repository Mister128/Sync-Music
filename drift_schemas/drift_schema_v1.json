          "sql": "CREATE TABLE IF NOT EXISTS \"tracks\" (\"id\" TEXT NOT NULL, \"content_hash\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL, \"artist_name\" TEXT NOT NULL DEFAULT 'Unknown artist', \"album_title\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"local_path\" TEXT NULL, \"size_bytes\" INTEGER NOT NULL DEFAULT 0, \"file_mtime_ms\" INTEGER NULL, \"artwork_hash\" TEXT NULL, \"added_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, \"delete_at_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
